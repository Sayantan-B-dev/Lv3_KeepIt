{
  "_comment": "This is a depcheck configuration file. Depcheck is a static analysis tool that scans the project to find unused or missing dependencies by analyzing imports across the codebase. Some packages are required indirectly by build tools (Vite, Tailwind, PostCSS) and are falsely reported as unused. The ignores list below prevents depcheck from flagging those known false positives.",

  "ignores": [
    "tailwindcss",
    "postcss",
    "autoprefixer",
    "@tailwindcss/postcss",
    "@vitejs/plugin-react",
    "dotenv"
  ]
}
